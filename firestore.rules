// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function hasRole(role) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin');
    }
    function isSameOrg(orgId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;
    }

    // ── Users ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Organizations ────────────────────────────────────────────
    match /organizations/{orgId} {
      allow read:   if isAuthenticated() && isSameOrg(orgId);
      allow write:  if isAdmin();

      // ── Contacts ──────────────────────────────────────────────
      match /contacts/{contactId} {
        allow read:   if isAuthenticated() && isSameOrg(orgId);
        allow create: if isAuthenticated() && isSameOrg(orgId);
        allow update: if isAuthenticated() && isSameOrg(orgId);
        allow delete: if isAdmin() || hasRole('manager');
      }

      // ── Companies ─────────────────────────────────────────────
      match /companies/{companyId} {
        allow read:   if isAuthenticated() && isSameOrg(orgId);
        allow write:  if isAuthenticated() && isSameOrg(orgId);
      }

      // ── Deals ─────────────────────────────────────────────────
      match /deals/{dealId} {
        allow read:   if isAuthenticated() && isSameOrg(orgId);
        allow create: if isAuthenticated() && isSameOrg(orgId);
        allow update: if isAuthenticated() && isSameOrg(orgId);
        allow delete: if isAdmin() || hasRole('manager');
      }

      // ── Tickets ───────────────────────────────────────────────
      match /tickets/{ticketId} {
        allow read:   if isAuthenticated() && isSameOrg(orgId);
        allow write:  if isAuthenticated() && isSameOrg(orgId);
      }

      // ── Campaigns ─────────────────────────────────────────────
      match /campaigns/{campaignId} {
        allow read:   if isAuthenticated() && isSameOrg(orgId);
        allow write:  if isAuthenticated() && isSameOrg(orgId) &&
                         (hasRole('marketing') || hasRole('manager') || isAdmin());
      }

      // ── Workflows ─────────────────────────────────────────────
      match /workflows/{workflowId} {
        allow read:   if isAuthenticated() && isSameOrg(orgId);
        allow write:  if isAdmin() || hasRole('manager');
      }

      // ── Invoices ──────────────────────────────────────────────
      match /invoices/{invoiceId} {
        allow read:   if isAuthenticated() && isSameOrg(orgId) &&
                         (isAdmin() || hasRole('finance') || hasRole('manager'));
        allow write:  if isAdmin() || hasRole('finance');
      }

      // ── Activities ────────────────────────────────────────────
      match /activities/{activityId} {
        allow read:   if isAuthenticated() && isSameOrg(orgId);
        allow create: if isAuthenticated() && isSameOrg(orgId);
        allow update: if isAuthenticated() && isSameOrg(orgId);
        allow delete: if isAdmin();
      }

      // ── Settings ──────────────────────────────────────────────
      match /settings/{settingId} {
        allow read:   if isAuthenticated() && isSameOrg(orgId);
        allow write:  if isAdmin();
      }

      // ── Audit Logs (append-only) ──────────────────────────────
      match /audit_logs/{logId} {
        allow read:   if isAdmin();
        allow create: if isAuthenticated() && isSameOrg(orgId);
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
